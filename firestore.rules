rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validations ---

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'role', 'createdAt'])
          && data.keys().size() <= 6
          && data.uid == request.auth.uid
          && data.fullName is string && data.fullName.size() <= 100
          && data.email is string && data.email.size() <= 100
          && data.role in ['client', 'counselor']
          // Using request.time for absolute temporal integrity
          && (request.method == 'create' ? data.createdAt == request.time : true);
    }

    function isValidCounselorProfile(data) {
      return data.keys().hasAll(['userId', 'specialization', 'bio', 'hourlyRate', 'isVerified'])
          && data.keys().size() <= 8
          && data.userId == request.auth.uid
          && data.specialization is string && data.specialization.size() <= 100
          && data.bio is string && data.bio.size() <= 2000
          && data.hourlyRate is number && data.hourlyRate >= 0
          && data.isVerified is bool;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['clientId', 'counselorId', 'startTime', 'endTime', 'status', 'paymentStatus', 'amount'])
          && data.keys().size() <= 9
          && (data.clientId == request.auth.uid || data.counselorId == request.auth.uid)
          && data.startTime is timestamp
          && data.endTime is timestamp
          && data.status in ['pending', 'confirmed', 'completed', 'cancelled']
          && data.paymentStatus in ['unpaid', 'paid']
          && data.amount is number;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['senderId', 'text', 'timestamp', 'appointmentId'])
          && data.keys().size() == 4
          && data.senderId == request.auth.uid
          && data.text is string && data.text.size() <= 1000
          && (request.method == 'create' ? data.timestamp == request.time : true);
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) 
          && isValidUserProfile(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'photoURL']);
    }

    match /counselorProfiles/{profileId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(profileId) && isValidCounselorProfile(incoming());
      allow update: if isOwner(existing().userId)
          && isValidCounselorProfile(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['specialization', 'bio', 'hourlyRate', 'availability']);
    }

    match /appointments/{appointmentId} {
      allow get: if isSignedIn() && isValidId(appointmentId) && (existing().clientId == request.auth.uid || existing().counselorId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.clientId == request.auth.uid || resource.data.counselorId == request.auth.uid);
      
      allow create: if isSignedIn() && isValidId(appointmentId) && isValidAppointment(incoming()) && incoming().clientId == request.auth.uid;
      
      allow update: if isSignedIn() && isValidId(appointmentId)
          && (existing().clientId == request.auth.uid || existing().counselorId == request.auth.uid)
          && isValidAppointment(incoming())
          && (
            // Only counselor can confirm
            (existing().counselorId == request.auth.uid && incoming().status == 'confirmed' && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
            // Either can cancel
            (incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
            // Payment status update
            (incoming().paymentStatus == 'paid' && incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'status']))
          );
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/appointments/$(appointmentId)).data.clientId == request.auth.uid 
                     || get(/databases/$(database)/documents/appointments/$(appointmentId)).data.counselorId == request.auth.uid);
        allow create: if isSignedIn() && isValidId(messageId) && isValidChatMessage(incoming())
                     && (get(/databases/$(database)/documents/appointments/$(appointmentId)).data.clientId == request.auth.uid 
                         || get(/databases/$(database)/documents/appointments/$(appointmentId)).data.counselorId == request.auth.uid);
      }
    }
  }
}
